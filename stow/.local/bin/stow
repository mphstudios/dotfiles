#!/usr/bin/env sh
#
# Stow wrapper that adds subcommands for managing dotfile packages.
# Run `stow --help` for wrapper and GNU Stow documentation.
#
# All other arguments are forwarded to GNU Stow.
#
set -e

# Find the real stow, skipping this wrapper
wrapper_dir="$(cd "$(dirname "$0")" && pwd)"
STOW=""
saved_ifs="$IFS"
IFS=:
for dir in $PATH; do
  [ "$dir" = "$wrapper_dir" ] && continue
  [ -x "$dir/stow" ] && STOW="$dir/stow" && break
done
IFS="$saved_ifs"

if [ -z "$STOW" ]; then
  echo "error: GNU Stow not found on PATH" >&2
  exit 1
fi

export STOW_DIR="${STOW_DIR:-$HOME/Code/dotfiles}"

usage() {
  cat <<EOF
Stow wrapper for managing dotfile packages.

Usage: stow add <path>              adopt a file or directory into a package
       stow scan                    scan ~/.config for unmanaged packages
       stow remove [-f|--force] <package>   unlink stowed packages
       stow [flags] <packages>      forwarded to GNU Stow

The add path is resolved relative to the current directory.
The package name is derived from the basename of the path.

EOF
}

add_package() {
  path="$1"

  # Resolve to absolute path
  case "$path" in
    /*) absolute="$path" ;;
    *)  absolute="$(cd "$(dirname "$path")" 2>/dev/null && pwd)/$(basename "$path")" ;;
  esac

  # Verify the path is under $HOME
  case "$absolute" in
    "$HOME"/*) ;;
    *)
      echo "error: $absolute is not under \$HOME" >&2
      return 1
      ;;
  esac

  if [ ! -e "$absolute" ]; then
    echo "error: $absolute does not exist" >&2
    return 1
  fi

  relative="${absolute#$HOME/}"
  package="$(basename "$absolute" | sed 's/^\.//')"

  if [ -z "$package" ]; then
    echo "error: could not derive package name from $path" >&2
    return 1
  fi

  if [ -d "$STOW_DIR/$package" ]; then
    echo "skip: $package already managed" >&2
    return 1
  fi

  dest="$STOW_DIR/$package/$relative"

  mkdir -p "$(dirname "$dest")"
  mv "$absolute" "$dest"
  "$STOW" "$package"
  echo "added $package: ~/$relative"
}

# Check if a name is already managed by any stow package:
# either as a top-level package or as .config/<name> inside
# a differently-named package, for example ruby/.config/gem
is_managed() {
  [ -d "$STOW_DIR/$1" ] && return 0
  for package_dir in "$STOW_DIR"/[!.]*/; do
    [ -d "${package_dir}.config/$1" ] && return 0
  done
  return 1
}

scan_dotconfig() {
  for dir in "$HOME"/.config/*/; do
    [ -L "$dir" ] && continue
    name="$(basename "$dir")"
    is_managed "$name" && continue

    printf "Add %s? [y/N] " "$name"
    read -r answer
    case "$answer" in
      [yY]*) "$0" add "$dir" ;;
    esac
  done
}

case "${1:-}" in
  --help|-h)
    usage
    exec "$STOW" --help
    ;;
  add)
    if [ -z "${2:-}" ]; then
      echo "usage: stow add <path>" >&2
      exit 1
    fi
    add_package "$2"
    ;;
  remove)
    shift
    force=false
    if [ "${1:-}" = "-f" ] || [ "${1:-}" = "--force" ]; then
      force=true
      shift
    fi
    if [ -z "${1:-}" ]; then
      echo "usage: stow remove [-f] <package>..." >&2
      exit 1
    fi
    if [ "$force" = false ]; then
      printf 'Unlink dotfiles package `%s` from $HOME directory? [y/N] ' "$*"
      read -r answer
      case "$answer" in
        [yY]*) ;;
        *) exit 0 ;;
      esac
    fi
    exec "$STOW" --delete "$@"
    ;;
  scan)
    scan_dotconfig
    ;;
  *)
    exec "$STOW" "$@"
    ;;
esac
