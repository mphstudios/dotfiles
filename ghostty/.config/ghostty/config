# This is the configuration file for Ghostty.
# @see https://ghostty.org/docs/config

# Generated by Spectre - Ghostty Config Generator
# https://github.com/imrajyavardhan12/spectre-ghostty-config

# Use Nushell as the default shell
shell-integration = "nushell"

# Colors
theme = Catppuccin Macchiato

# Fonts
font-family = "Liga SFMono Nerd Font"
font-size = 16

background-opacity = 0.88
cursor-style = "block"
cursor-style-blink = true
shell-integration-features = "no-cursor"

# Keybinding
keybind = global:cmd+escape=toggle_quick_terminal

# Macos
macos-custom-icon = ~/.config/ghostty/ghostty.icns
macos-icon = custom-style
macos-icon-frame = beige
macos-icon-ghost-color = "#04B575"
macos-icon-screen-color = "#04B575"

macos-option-as-alt = true

macos-titlebar-proxy-icon = hidden
macos-titlebar-style = native

# Mouse
focus-follows-mouse = true
mouse-hide-while-typing = true
mouse-scroll-multiplier = 2

# Window
background-blur-radius = 5
background-opacity = 0.9
background-opacity-cells = true

window-colorspace = "display-p3"
window-decoration = true
window-save-state = always
window-subtitle = working-directory
window-theme = system

window-padding-balance = true
window-padding-x = 4
window-padding-y = 4

window-width = 130
window-height = 65
