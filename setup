#!/usr/bin/env sh
#
# Install dotfiles with GNU Stow, stowing all packages and symlinking
# the .stowrc file so that `stow` can be run directly from $HOME
#
set -e

export STOW_DIR="$(cd "$(dirname "$0")" && pwd)"

case "${1:-}" in
  --help|-h)
    cat <<EOF
Install dotfiles by stowing all packages and symlinking .stowrc
so that stow can be run directly from \$HOME.

Usage: ./setup

After installation, use stow to manage individual packages.
Run stow --help for available commands.
EOF
    exit 0
    ;;
  "")
    ;;
  *)
    echo "unknown option: $1" >&2
    exit 1
    ;;
esac

# Symlink .stowrc so stow can be run from $HOME
ln -sf "$STOW_DIR/.stowrc" "$HOME/.stowrc"

# [!.]*/ excludes hidden directories (.git, .claude, et cetera)
# because when bash dotglob is set */ matches dotfiles as well
output="$(cd "$STOW_DIR" && stow --verbose [!.]*/ 2>&1)" || { echo "$output" >&2; exit 1; }
if [ -n "$output" ]; then
  echo "$output"
else
  echo "all packages up to date"
fi
